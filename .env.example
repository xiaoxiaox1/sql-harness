# LLM (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
MAX_TURNS_PER_REQUEST=8

# Database: sqlite | doris
DB_TYPE=sqlite
DB_PATH=./data/demo.db

# Doris / MySQL-protocol
# DB_HOST=127.0.0.1
# DB_PORT=9030
# DB_USER=readonly
# DB_PASSWORD=
# DB_DATABASE=ldc_prod

# SQL safety / limits
SQL_MAX_ROWS=200
SQL_TIMEOUT_SEC=30
SQL_MAX_RESULT_CHARS=12000
